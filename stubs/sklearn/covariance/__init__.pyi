import numpy as np
from numpy.typing import NDArray

class OAS:
    covariance_: NDArray[np.float64]
    def __init__(self) -> None: ...
    def fit(self, features: NDArray[np.float64]) -> OAS: ...

class LedoitWolf:
    covariance_: NDArray[np.float64]
    def __init__(self) -> None: ...
    def fit(self, features: NDArray[np.float64]) -> LedoitWolf: ...
