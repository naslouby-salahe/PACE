import numpy as np
from numpy.typing import NDArray

class IsolationForest:
    def __init__(self, n_estimators: int, random_state: int, n_jobs: int) -> None: ...
    def fit(self, features: NDArray[np.float64]) -> IsolationForest: ...
    def score_samples(self, features: NDArray[np.float64]) -> NDArray[np.float64]: ...

class HistGradientBoostingClassifier:
    def __init__(
        self, max_iter: int, learning_rate: float, random_state: int, early_stopping: bool
    ) -> None: ...
    def fit(
        self, features: NDArray[np.float64], labels: NDArray[np.float64]
    ) -> HistGradientBoostingClassifier: ...
    def decision_function(self, features: NDArray[np.float64]) -> NDArray[np.float64]: ...
