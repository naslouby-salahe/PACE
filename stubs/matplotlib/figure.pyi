from collections.abc import Sequence
from pathlib import Path

from matplotlib.artist import Artist
from matplotlib.axes import Axes, Bbox

class Figure:
    axes: list[Axes]
    bbox: Bbox
    def __init__(self, figsize: tuple[float, float], layout: str) -> None: ...
    def add_subplot(self, nrows: int, ncols: int, index: int) -> Axes: ...
    def suptitle(self, title: str, x: float = 0.5) -> Artist: ...
    def supxlabel(self, label: str, fontsize: float = ...) -> Artist: ...
    def get_suptitle(self) -> str: ...
    def draw_without_rendering(self) -> None: ...
    def legend(self, handles: Sequence[Artist] | None = None, **kwargs: object) -> Artist: ...
    def savefig(
        self,
        path: Path,
        format: str,
        dpi: float | None = None,
        metadata: dict[str, None] | None = None,
    ) -> None: ...
