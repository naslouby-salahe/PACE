from collections.abc import Sequence
from typing import Any

import numpy as np
from matplotlib.artist import Artist
from matplotlib.ticker import Locator
from numpy.typing import NDArray

class Line:
    def get_linestyle(self) -> str: ...
    def get_linewidth(self) -> float: ...
    def get_marker(self) -> str: ...

class Bbox:
    x0: float
    x1: float
    y0: float
    y1: float
    width: float
    intervalx: tuple[float, float]
    intervaly: tuple[float, float]
    def overlaps(self, other: Bbox) -> bool: ...

class Text(Artist):
    def get_window_extent(self) -> Bbox: ...
    def get_text(self) -> str: ...
    def get_rotation(self) -> float: ...
    def get_position(self) -> tuple[float, float]: ...
    def get_bbox_patch(self) -> Artist | None: ...

class Axis:
    label: Text
    def set_major_locator(self, locator: Locator) -> None: ...

Data = Sequence[float] | NDArray[np.number[Any]] | float
Labels = Sequence[str]
Errors = Sequence[Sequence[float]] | NDArray[np.number[Any]] | float | None

class Axes:
    dataLim: Bbox
    texts: list[Text]
    title: Text
    xaxis: Axis
    yaxis: Axis
    def annotate(self, text: str, xy: tuple[float, float], **kwargs: object) -> Artist: ...
    def get_title(self) -> str: ...
    def get_xticklabels(self) -> list[Text]: ...
    def get_xticks(self) -> list[float]: ...
    def get_yticklabels(self) -> list[Text]: ...
    def get_xlabel(self) -> str: ...
    def get_ylabel(self) -> str: ...
    def get_position(self) -> Bbox: ...
    def get_lines(self) -> list[Line]: ...
    def set_title(self, label: str) -> None: ...
    def set_xlabel(self, label: str) -> None: ...
    def set_ylabel(self, label: str) -> None: ...
    def set_xscale(self, value: str) -> None: ...
    def set_yscale(self, value: str) -> None: ...
    def set_xlim(self, left: float, right: float) -> None: ...
    def set_ylim(self, bottom: float, top: float) -> None: ...
    def get_ylim(self) -> tuple[float, float]: ...
    def get_xlim(self) -> tuple[float, float]: ...
    def set_xticks(self, ticks: Data, labels: Labels | None = None, **kwargs: object) -> None: ...
    def set_yticks(self, ticks: Data, labels: Labels | None = None, **kwargs: object) -> None: ...
    def grid(self, **kwargs: object) -> None: ...
    def plot(self, x: Data, y: Data, **kwargs: object) -> list[Artist]: ...
    def step(self, x: Data, y: Data, **kwargs: object) -> list[Artist]: ...
    def scatter(self, x: Data, y: Data, **kwargs: object) -> Artist: ...
    def errorbar(
        self, x: Data, y: Data, xerr: Errors = None, yerr: Errors = None, **kwargs: object
    ) -> Artist: ...
    def bar(self, x: Data, height: Data, **kwargs: object) -> Artist: ...
    def barh(self, y: Data, width: Data, **kwargs: object) -> Artist: ...
    def fill_between(self, x: Data, y1: Data, y2: Data, **kwargs: object) -> Artist: ...
    def axhline(self, y: float, **kwargs: object) -> Artist: ...
    def axvline(self, x: float, **kwargs: object) -> Artist: ...
    def legend(self, *args: object, **kwargs: object) -> Artist: ...
    def get_legend_handles_labels(self) -> tuple[list[Artist], list[str]]: ...
